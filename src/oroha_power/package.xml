<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>oroha_power</name>
  <version>2.0.0</version>
  <description>OROHA current/bus-voltage measurement host node for the Raspberry Pi Pico firmware (oroha-bench-1.x): raw ADC + calibrated values as oroha_msgs/PowerSample, BatteryState, diagnostics, zero service.</description>
  <maintainer email="taesuyim.kopo@gmail.com">Taesu Yim</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_srvs</depend>
  <depend>oroha_msgs</depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
